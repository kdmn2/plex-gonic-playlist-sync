# Example environment file. Copy to .env and fill in.
# Prefer *_FILE variants so secrets are not stored in the environment.

# ---- Plex ----
PLAYLIST_SYNC_PLEX__URL=http://plex:32400
PLAYLIST_SYNC_PLEX__TOKEN=change-me
# PLAYLIST_SYNC_PLEX__TOKEN_FILE=/run/secrets/plex_token
PLAYLIST_SYNC_PLEX__LIBRARY_SECTIONS=["Music"]
# PLAYLIST_SYNC_PLEX__VERIFY_TLS=true
# PLAYLIST_SYNC_PLEX__CA_BUNDLE=/etc/ssl/certs/internal-ca.pem

# ---- Gonic ----
PLAYLIST_SYNC_GONIC__URL=http://gonic:4747
PLAYLIST_SYNC_GONIC__USERNAME=admin
PLAYLIST_SYNC_GONIC__PASSWORD=change-me
# PLAYLIST_SYNC_GONIC__PASSWORD_FILE=/run/secrets/gonic_password
# PLAYLIST_SYNC_GONIC__USE_TOKEN_AUTH=true

# ---- Sync behaviour ----
PLAYLIST_SYNC_SYNC__POLL_SECONDS=300
PLAYLIST_SYNC_SYNC__DURATION_TOLERANCE_MS=2000
PLAYLIST_SYNC_SYNC__BLOCK_ON_UNMATCHED=true
PLAYLIST_SYNC_SYNC__ALLOW_PARTIAL=false
PLAYLIST_SYNC_SYNC__ALLOW_CLEAR_TARGET_WHEN_SOURCE_EMPTY=false
# Path roots are required for reliable matching (same files, two mounts):
# PLAYLIST_SYNC_SYNC__PATH_ROOTS=[{"name":"music","plex_root":"/data/music","gonic_root":"/music"}]

# ---- UI (required for `serve`; the UI refuses to start without a password) ----
PLAYLIST_SYNC_UI__USERNAME=admin
PLAYLIST_SYNC_UI__PASSWORD=change-me
# PLAYLIST_SYNC_UI__PASSWORD_FILE=/run/secrets/ui_password
# PLAYLIST_SYNC_UI__SESSION_SECRET=change-me-too

PLAYLIST_SYNC_LOG_LEVEL=INFO

# ---- Container ownership (entrypoint drops to this user) ----
# Match the owner of your appdata folders. On Unraid use PUID=99 PGID=100.
PUID=1000
PGID=1000
